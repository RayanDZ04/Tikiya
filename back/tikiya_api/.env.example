# Exemple de configuration pour tikiya_api
# Copie en .env et adapte.

# Server
PORT=8080
RUST_LOG=info,tikiya_api=debug

# Database
# Pour docker-compose, utiliser le host "db"
DATABASE_URL=postgres://tikiya:tikiya@db:5432/tikiya
DATABASE_POOL_MAX=20

# JWT
# 32+ caractères, évite "change-me"
JWT_SECRET=replace_with_a_long_random_secret_value_min_32_chars
JWT_ISSUER=tikiya-api
JWT_AUDIENCE=tikiya-clients

# Clé HMAC pour signer les URLs de confirmation de paiement.
# Doit être différente de JWT_SECRET (32+ caractères, évite "change-me").
PAYMENT_URL_HMAC_SECRET=replace_with_a_different_long_random_secret_min_32_chars

# Résilience HTTP (anti-crash)
HTTP_REQUEST_TIMEOUT_SECS=15
# Conseil: HTTP_CONCURRENCY_LIMIT ≈ DATABASE_POOL_MAX * 4
HTTP_CONCURRENCY_LIMIT=80
HTTP_MAX_BODY_BYTES=1048576

# Anti-bot / brute-force (rate limit par IP)
RATE_LIMIT_PER_SECOND=20
RATE_LIMIT_BURST=40

# Uploads (quota par utilisateur + taille max par fichier)
UPLOAD_MAX_FILE_BYTES=5242880
UPLOAD_QUOTA_BYTES_PER_USER=52428800

# Redis — rate limiting distribué entre plusieurs instances de l'API.
# Vide = désactivé (mode 1 instance / dev). En prod: redis://redis:6379
REDIS_URL=

# Refus des mots de passe déjà fuités (HaveIBeenPwned, k-anonymat).
# false par défaut (aucun appel externe en dev/test) ; true en prod.
PWNED_CHECK_ENABLED=false

# CAPTCHA anti-robot à l'inscription (Cloudflare Turnstile).
# Vide = désactivé. En prod : le secret du dashboard Turnstile. Le front doit
# alors envoyer un champ captcha_token à /register.
CAPTCHA_SECRET=

# Stockage objet (MinIO/S3) pour les fichiers uploadés.
# S3_BUCKET vide = stockage sur disque local (dossier uploads/, dev uniquement).
# En prod avec MinIO:
#   S3_ENDPOINT=http://minio:9000
#   S3_BUCKET=tikiya-uploads
#   S3_ACCESS_KEY=... (= MINIO_ROOT_USER)
#   S3_SECRET_KEY=... (= MINIO_ROOT_PASSWORD)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Reverse proxy (Nginx/Traefik/Cloudflare)
# Mettre à true uniquement si tu fais confiance aux headers X-Forwarded-For
TRUST_PROXY_HEADERS=false

# HSTS (uniquement si servi en HTTPS au niveau proxy)
HTTP_HSTS=false

# Google OAuth (optionnel)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Resend (envoi des emails OTP) — vide = mode dev, le code est juste loggé
RESEND_API_KEY=
# Attention: si la valeur contient des espaces/< >, l'entourer de guillemets.
RESEND_FROM="Tikiya <noreply@tikiya.dz>"
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Variables utilisées par docker-compose lui-même (substitution ${VAR} dans
# docker-compose.yml / docker-compose.prod.yml). Copie en `.env` à la racine
# et adapte — ce fichier racine est différent de back/tikiya_api/.env
# (qui configure l'API elle-même).

# Mot de passe Postgres — change impérativement cette valeur avant tout
# déploiement public (ne jamais garder la valeur par défaut "tikiya").
DB_PASSWORD=change_me_to_a_strong_random_password

# Identifiants MinIO (stockage objet en prod). À changer aussi avant déploiement.
MINIO_ROOT_USER=tikiya
MINIO_ROOT_PASSWORD=change_me_to_a_strong_random_password
